<Page x:Class="CookBook.Pages.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Login">
    <Grid Margin="30">
        <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин" Foreground="White"/>
            <TextBox x:Name="tbLogin"/>
            <TextBlock Text="Пароль" Foreground="White"/>
            <PasswordBox x:Name="pbPassword"/>
            <Button Content="Войти" Style="{StaticResource MagicButtonStyle}" Click="BtnLogin_Click"/>
            <Button Content="Регистрация" Style="{StaticResource MagicButtonStyle}" Click="BtnRegister_Click"/>
        </StackPanel>
    </Grid>
</Page>
