<Page x:Class="CookBook.Pages.PageLike"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#2C3E50">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="listProducts">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="6" Padding="8" Background="#34495E" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Width="110" Height="90" Stretch="UniformToFill" Source="{Binding CurrentPhoto}"/>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding RecipeName}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding CategoryDisplay}" Foreground="White"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="White"/>
                                <TextBlock Text="{Binding CookingTime, StringFormat=Время приготовления: {0} мин.}" Foreground="White"/>
                                <Button x:Name="btnDelete" Content="Удалить из избранного" Tag="{Binding}" Click="btnDelete_Click" Style="{StaticResource MagicButtonStyle}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="1" Content="Назад" Click="btnBack_Click" Style="{StaticResource MagicButtonStyle}" HorizontalAlignment="Left"/>
    </Grid>
</Page>
